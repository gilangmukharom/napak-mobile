<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Tourvella</string>
		<!-- Izin lokasi.
	     Teksnya muncul apa adanya di dialog iOS, jadi ditulis dengan bahasa
	     yang sama dengan isi aplikasi: menjelaskan apa gunanya, bukan sekadar
	     meminta. Orang berhak tahu untuk apa lokasinya dipakai sebelum
	     menyerahkannya. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Tourvella merekam jejak perjalananmu selama aplikasi terbuka. Semua trip tersimpan tertutup — kamu sendiri yang memutuskan kapan dibagikan.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Supaya Tourvella bisa terus merekam saat layar mati — touring seharian tidak mungkin sambil menatap layar. Perekaman hanya berjalan setelah kamu menekan Mulai.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>Supaya Tourvella bisa terus merekam saat layar mati — touring seharian tidak mungkin sambil menatap layar. Perekaman hanya berjalan setelah kamu menekan Mulai.</string>
		<!-- Untuk menyimpan video animasi rute ke galeri. -->
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Untuk menyimpan video perjalananmu ke galeri.</string>
		<!-- Kamera, mikrofon, dan galeri: foto & video singgahan, foto
		     profil, dan foto kendaraan di garasi. Tanpa teks ini iOS menutup
		     paksa aplikasinya begitu kamera dibuka — bukan menolak, menutup. -->
		<key>NSCameraUsageDescription</key>
		<string>Untuk memotret singgahan perjalanan, foto profilmu, dan kendaraan di garasimu.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Untuk ngobrol lewat intercom dengan rombongan Trip Bareng, dan merekam suara di video singgahan. Suara intercom tidak pernah direkam.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Untuk memilih foto dan video singgahan dari galerimu.</string>
		<!-- Perekaman harus tetap jalan saat aplikasi di latar belakang. -->
		<!-- ============================================================
	     App Transport Security

	     Tidak ada pengecualian di sini, dan memang sebaiknya begitu.
	     Backend Tourvella diakses lewat Cloudflare Tunnel yang sudah HTTPS
	     dengan sertifikat sah, jadi ATS tidak perlu dilonggarkan sama
	     sekali — termasuk saat mencoba dari HP sungguhan.

	     NSAllowsLocalNetworking aman dan boleh tetap ada: ia cuma
	     mengizinkan tujuan di jaringan lokal, bukan membuka semuanya.

	     Kalau suatu saat terpaksa menembak backend lewat HTTP polos di
	     alamat LAN, tambahkan NSAllowsArbitraryLoads SEMENTARA lalu hapus
	     lagi. Apple menanyakannya saat review, dan membiarkannya menyala
	     berarti seluruh lalu lintas aplikasi boleh tanpa enkripsi.
	     ============================================================ -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsLocalNetworking</key>
			<true/>
		</dict>
		<!-- iOS 14+ meminta izin sebelum aplikasi menyapa jaringan lokal. -->
		<key>NSLocalNetworkUsageDescription</key>
		<string>Untuk menyambung ke backend Tourvella yang sedang berjalan di jaringan yang sama saat pengembangan.</string>
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
			<string>fetch</string>
			<!-- Intercom Trip Bareng tetap jalan saat HP dikunci di saku jaket. -->
			<string>audio</string>
		</array>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>tourvella</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
